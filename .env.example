# Money_Book 环境变量样例
# 复制为 .env 并填入真实值；.env 不进 git
# 用 `npm run gen-password` 生成 APP_PASSWORD_HASH

# ============ 登录认证（单账号）============
# bcrypt 哈希，必填；不配则禁止登录
# 用法：npm run gen-password，把输出的 $2a$12$... 串粘到这里
APP_PASSWORD_HASH=$2a$12$CQrF5M2yrxivL3zfn6ro/OKsDWJJpOGvjvuyQrYM5n3bQKjDEsB.K

# Cookie 是否仅 HTTPS 传输；内网 HTTP 部署时设 false
# 公网部署（有 HTTPS/反代）必须设 true
COOKIE_SECURE=false

# Session 有效期（分钟），默认 20
# 滑动过期：活跃用户每次请求自动续期；闲置超过该时间才失效
SESSION_TTL_MINUTES=20

# AI Agent 长期 API Token（可选，强烈推荐配置）
# 配置后 Agent 调用时带 Authorization: Bearer <token>，不走 session 过期
# 生成方式：openssl rand -hex 32（或任意 ≥32 字节的随机串）
# 不配则 Agent 也得走登录流程，每次到期都要重新登录
AGENT_API_TOKEN=

# ============ 服务监听 ============
# 端口
PORT=3001

# 绑定的网卡 IP；内网单人场景建议设为内网 IP，如 192.168.1.10
# 不配或留空则监听 0.0.0.0（所有网卡，含公网）
# 推荐绑定内网 IP，避免误暴露到公网
HOST=

# ============ 数据库 ============
# 默认 ./data/money.db，一般不需要改
DB_PATH=
